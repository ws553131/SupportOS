# SupportOS 环境变量模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env        （命令：Copy-Item .env.example .env）
#   2. 把你的真实 Key 填进 .env
#   3. .env 已被 .gitignore 忽略，绝不会提交到 git
# ============================================================

# ---------- LLM（必需）----------
# 推荐 DeepSeek：便宜、OpenAI SDK 兼容、中文好
# 申请地址：https://platform.deepseek.com/api_keys
SUPPORTOS_LLM_PROVIDER=deepseek
SUPPORTOS_LLM_API_KEY=sk-你的deepseek密钥
SUPPORTOS_LLM_BASE_URL=https://api.deepseek.com/v1
SUPPORTOS_LLM_MODEL=deepseek-chat

# ---------- LLM 备用方案（可选，二选一即可）----------
# 通义千问 DashScope（有免费额度）
# DASHSCOPE_API_KEY=sk-你的阿里云密钥
#
# 智谱 GLM
# ZHIPU_API_KEY=你的智谱密钥

# ---------- 应用配置 ----------
SUPPORTOS_ENV=dev
SUPPORTOS_LOG_LEVEL=INFO
SUPPORTOS_DB_PATH=data/supportos.db

# ---------- 评测配置 ----------
# LLM-as-Judge 是否启用（评测 Resolution Accuracy 用）
SUPPORTOS_EVAL_USE_JUDGE=true
# 为控制成本，评测时可切换到更便宜的模型
SUPPORTOS_EVAL_JUDGE_MODEL=deepseek-chat
